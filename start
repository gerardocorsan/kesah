#!/bin/bash
# Starts the API server (http://localhost:8080) and the web application's
# development server (http://localhost:5173), which proxies /api to the server.
# Installs the npm dependencies when app/node_modules is missing. Ctrl+C stops both.
root="$(cd "$(dirname "$0")" && pwd)"
[ -d "$root/app/node_modules" ] || (cd "$root/app" && npm install) || exit 1
(cd "$root/server" && cargo run -p api) &
server=$!
trap 'kill "$server" 2>/dev/null' EXIT
cd "$root/app" && npm run dev
