    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "solid-js": "^1.9.15"
  }
}
