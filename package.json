{
  "name": "kesah",
  "private": true,
  "version": "0.1.0",
  "description": "Editor visual de grafos en HTML + TypeScript",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
